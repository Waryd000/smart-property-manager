{
    email {$ACME_EMAIL}
}

{$DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        X-Frame-Options "DENY"
        -Server
    }

    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # Agreement and uploaded documents in /media/ are deliberately not
    # exposed by Caddy. Add a permission-checked download view first.
    reverse_proxy web:8000
}
