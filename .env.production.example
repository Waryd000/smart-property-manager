# Copy to .env.production on the VPS and replace every placeholder.
# This file is ignored by Git and must remain private.
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
DOMAIN=property.example.com
ACME_EMAIL=admin@example.com
ALLOWED_HOSTS=property.example.com
CSRF_TRUSTED_ORIGINS=https://property.example.com

DB_NAME=smart_property_manager
DB_USER=spm_user
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_DATABASE_PASSWORD
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

TIME_ZONE=Africa/Kampala
MEDIA_ROOT=/app/media
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
USE_X_FORWARDED_PROTO=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

DEFAULT_FROM_EMAIL=noreply@property.example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_SMTP_USERNAME
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=True
